# Environment & Deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Authentication & Access Control
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# Relational Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=
DIRECT_DATABASE_URL=

# Google Maps Platform (Privileged Server Key vs Restricted Browser Key)
GOOGLE_MAPS_SERVER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Meteorology & Environmental Integrations
NOAA_NWS_USER_AGENT=(CHART-Plus-OEH-App, contact@chartplus.org)

# Background Tasks & Cache Invalidation
CRON_SECRET=
REDIS_URL=

# Object Storage for Exported Scenario Reports
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Observability & Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Notification Delivery
EMAIL_PROVIDER_API_KEY=
NOTIFICATION_WEBHOOK_SECRET=

# Public Data Feeds Enablement
PUBLIC_DATA_REFRESH_ENABLED=true
